{
  "expo": {
    "name": "CapiTrack",
    "slug": "capitech",
    "owner": "drcoretech",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.capitrack.app"
    },
    "android": {
      "package": "com.capitrack.app",
      "adaptiveIcon": {
        "backgroundColor": "#1F2A24",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "./plugins/withNotificationListener.js"
    ],
    "extra": {
      "apiUrl": "https://capitrack-be.vercel.app/api",
      "eas": {
        "projectId": "05c8fca0-1f61-40a8-a6f8-438e03551ce4"
      }
    }
  }
}
