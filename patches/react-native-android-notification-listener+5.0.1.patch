+
+        String packageName = sbn.getPackageName();
+        if (packageName == null) return;
+        String pkgLower = packageName.toLowerCase();
+
+        // 1. Immediately drop notifications from CapiTrack itself or Android system UI
+        if (pkgLower.contains("capitrack") || pkgLower.equals("android") || pkgLower.equals("com.android.systemui")) {
+            return;
+        }
+
+        // 2. Immediately drop noisy social/chat/streaming apps in native Java without waking up JS engine
+        if (pkgLower.contains("whatsapp") || pkgLower.contains("instagram") || pkgLower.contains("facebook") ||
+            pkgLower.contains("twitter") || pkgLower.contains("snapchat") || pkgLower.contains("discord") ||
+            pkgLower.contains("telegram") || pkgLower.contains("youtube") || pkgLower.contains("netflix") ||
+            pkgLower.contains("spotify") || pkgLower.contains("tiktok") || pkgLower.contains("amazon") ||
+            pkgLower.contains("flipkart")) {
+            return;
+        }
+
+        // 3. Fast filter: check if the notification title or text contains any financial hint
+        CharSequence title = statusBarNotification.extras.getCharSequence(Notification.EXTRA_TITLE);
+        CharSequence text = statusBarNotification.extras.getCharSequence(Notification.EXTRA_TEXT);
+        CharSequence bigText = statusBarNotification.extras.getCharSequence(Notification.EXTRA_BIG_TEXT);
+
+        String combined = ((title != null ? title.toString() : "") + " " +
+                           (text != null ? text.toString() : "") + " " +
+                           (bigText != null ? bigText.toString() : "")).toLowerCase();
+
+        boolean isPaymentApp = pkgLower.contains("phonepe") || pkgLower.contains("paisa") ||
+                               pkgLower.contains("paytm") || pkgLower.contains("cred") ||
+                               pkgLower.contains("bhim") || pkgLower.contains("upi") ||
+                               pkgLower.contains("bank") || pkgLower.contains("sms") ||
+                               pkgLower.contains("mms") || pkgLower.contains("messaging");
+
+        boolean hasFinancialKeyword = combined.contains("paid") || combined.contains("debited") ||
+                                      combined.contains("spent") || combined.contains("sent") ||
+                                      combined.contains("received") || combined.contains("credited") ||
+                                      combined.contains("₹") || combined.contains("rs.") ||
+                                      combined.contains("rs ") || combined.contains("inr") ||
+                                      combined.contains("upi") || combined.contains("a/c") ||
+                                      combined.contains("acct");
+
+        if (!isPaymentApp && !hasFinancialKeyword) {
             return;
         }
 
